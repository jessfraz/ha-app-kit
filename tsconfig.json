{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/ui/src/**/*.js",
    "packages/ui/stories/**/*.js",
    ".storybook/**/*.js",
    "tests/**/*.js",
    "playwright.config.js"
  ]
}
